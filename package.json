{
  "name": "blahblah-toy",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prepare:skill": "node skills/blahblah-generator/scripts/compile.mjs",
    "dev": "npm run dev:toy",
    "dev:toy": "npm run prepare:skill && vite --config toy/vite.config.ts",
    "build": "npm run build:toy",
    "build:toy": "npm run prepare:skill && vite build --config toy/vite.config.ts",
    "preview:toy": "vite preview --config toy/vite.config.ts",
    "test": "npm run build:toy && node --test --experimental-strip-types tests/*.test.mjs",
    "test:unit": "npm run prepare:skill && node --test --experimental-strip-types tests/generation-quality.test.mjs",
    "eval:live": "node --experimental-strip-types scripts/evaluate-live.mjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
